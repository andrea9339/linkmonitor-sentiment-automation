# Copiare in .env e inserire credenziali proprie. Non pubblicare .env.
LINKMONITOR_EMAIL=utente@example.com
LINKMONITOR_PASSWORD=inserire-la-propria-password
# Inserire l'URL Analytics completo del proprio account, inclusi i frammenti #.
LINKMONITOR_URL="https://app.linkmonitor.it/app/page#/ANALYTICS"

# Il bot contiene selettori e prompt del caso d'uso originale nel settore betting.
TOPIC_NAME="Società di Gambling"
HEADLESS=true
MAX_LINKS=5
CONFIDENCE_THRESHOLD=0.75
FORCE_UPDATE=false
DRY_RUN=false
SLOW_MO_MS=0
NAVIGATION_TIMEOUT_MS=45000

# Percorsi relativi alla cartella del bot; i launcher usano questi percorsi standard.
CODEX_QUEUE_FILE=logs/codex_review_queue.jsonl
CODEX_DECISIONS_FILE=logs/codex_decisions.jsonl
